# Example only. start.sh reads environment variables, not this file automatically.
# Use: set -a; source .env; set +a; bash scripts/start.sh
CHEST_BACKEND=local
CHEST_PORT=7860
CHEST_HOST=127.0.0.1
CHEST_MAX_INPUT_TOKENS=8192
CHEST_CXR_EXPERT=1
CHEST_CXR_READER=legacy
CHEST_RECHECK_IMAGE=1
CHEST_CONSTRAINED_JSON=1
CHEST_CLINICAL_CONTRAST=1
# CHEST_MODEL_PATH=/absolute/path/to/Lingshu-32B-NF4
# API mode: configure locally; never commit the real key.
# CHEST_BACKEND=api
# CHEST_API_MODEL=your-model-name
# OPENAI_BASE_URL=https://your-provider.example/v1
# OPENAI_API_KEY=replace-locally
